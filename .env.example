# Copy this file to .env.local and fill in the values. Never commit real values.

# --- Database (Azure Database for PostgreSQL) ---
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AZURE_CONNECTION_STRING=
# Optional: maximum connections in the pool (default 10).
# DATABASE_POOL_MAX=10
# Only for a self-signed test server: set to 1 to skip certificate checks.
# DATABASE_SSL_NO_VERIFY=

# --- Login (NextAuth) ---
# The crm_users id of the CRM owner (the only account allowed in). It is the
# same id the owner had in Supabase Auth.
CRM_OWNER_ID=
# Signs the session cookie. A long random value, different per server:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
# The site's own address, e.g. https://investor-crm.crest-capital.com (http://localhost:3000 locally).
NEXTAUTH_URL=

# --- Supabase (Storage, until Phase 3 replaces it) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# --- Scheduled jobs ---
SCHEDULER_SECRET=

# --- AI and email ---
GEMINI_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
REMINDER_EMAIL_TO=
