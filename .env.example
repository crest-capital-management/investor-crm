# ==========================================
# 1. APPLICATION & AUTHENTICATION
# ==========================================
NEXTAUTH_URL=
NEXTAUTH_SECRET=
CRM_OWNER_ID=


# ==========================================
# 2. WHATSAPP CLOUD API & BUSINESS ACCOUNT
# ==========================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=


# ==========================================
# 3. WHATSAPP WEBHOOK & META SECURITY
# ==========================================
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=


# ==========================================
# 4. AI SERVICES & LLM API KEYS
# ==========================================
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# ==========================================
# 5. EMAIL SERVICES & NOTIFICATIONS
# ==========================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=
REMINDER_EMAIL_TO=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=


# ==========================================
# 6. DATABASE & STORAGE
# ==========================================
AZURE_CONNECTION_STRING=
AZURE_STORAGE_CONNECTION_STRING=
DATABASE_SSL_NO_VERIFY=


# ==========================================
# 7. SCHEDULER & BACKGROUND JOBS
# ==========================================
SCHEDULER_SECRET=


# ==========================================
# 8. ENCRYPTION KEYS (azure/ENCRYPTION_KEYS.md)
# ==========================================
# Required: the app does not start without the keys.
# Azure Key Vault holding the secrets crm-field-keys and crm-index-key.
# On a PC, sign in first with `az login`.
KEY_VAULT_URL=https://<vault-name>.vault.azure.net/

# Development keys, ONLY for a separate test database (refused in production,
# never use them against the live database):
# CRM_FIELD_KEYS={"current":"k1","keys":{"k1":"<base64 of 32 random bytes>"}}
# CRM_INDEX_KEY=<base64 of 32 random bytes>