# Copy this file to .env.local and fill in the values. Never commit real values.

# --- Database (Azure Database for PostgreSQL) ---
# postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
# Optional: maximum connections in the pool (default 10).
# DATABASE_POOL_MAX=10
# Only for a self-signed test server: set to 1 to skip certificate checks.
# DATABASE_SSL_NO_VERIFY=

# --- Access control ---
# The Supabase Auth user id of the CRM owner (the only account allowed in).
CRM_OWNER_ID=

# --- Supabase (Auth and Storage, until Phases 2 and 3 replace them) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# --- Scheduled jobs ---
SCHEDULER_SECRET=

# --- AI and email ---
GEMINI_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
REMINDER_EMAIL_TO=
